# Copy to .env (gitignored) and fill in as needed. docker compose reads .env automatically.

# "Anthropic" or "Ollama". Defaults to Ollama in docker-compose.yml so `docker compose up`
# works with no secrets at all.
LLM_PROVIDER=Ollama

# Only required when LLM_PROVIDER=Anthropic — user secrets on the host aren't visible
# inside the container, so the key has to be passed in here instead.
ANTHROPIC_API_KEY=

# Must be a tool-calling-capable Ollama model. Pull it once with:
#   docker compose exec ollama ollama pull llama3.2:3b
# qwen3:4b / qwen3:8b are heavier alternatives with stronger multi-step tool calling.
OLLAMA_MODEL=llama3.2:3b
