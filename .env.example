# Copy to .env (gitignored) and override as needed. docker compose reads .env automatically.

# Which LLM backend the assistant uses:
#   Ollama    - local, no API key (default)
#   Anthropic - Claude models
#   OpenAI    - GPT models
#   Google    - Gemini models (official Google.GenAI SDK)
LLM_PROVIDER=Ollama

# Ollama models, space-separated: the FIRST is the assistant's default; all of them are
# downloaded automatically on startup and offered in the console's model dropdown. Edit
# and re-run the up script to change the lineup. qwen2.5:7b is a heavier alternative
# with stronger multi-step tool calling.
#
# The lineup, measured by replaying the same reads against the seeded board — the console shows
# these notes next to each name:
#   qwen2.5:3b         the default. Fast, and listed all eight seeded items every time.
#   qwen3:4b-instruct  the steadiest tool caller — asked for exactly the right read every time.
#                      3.2GB resident, so it wants the card to itself; switching models unloads
#                      the previous one, which is what keeps it off the CPU.
#   qwen2.5:1.5b       kept deliberately as the weak-model test case — it answers without reading
#                      anything roughly half the time, which is what the loop's listing guard
#                      exists to catch. Not a model to actually use.
OLLAMA_MODELS=qwen2.5:3b qwen3:4b-instruct qwen2.5:1.5b

# How long Ollama keeps a model in memory after use. Default -1 (forever) so replies stay
# fast; set e.g. 10m to free the (V)RAM when idle at the cost of a ~1 min reload.
#OLLAMA_KEEP_ALIVE=-1

# Ollama compute: leave empty for CPU (default). To run on the host's NVIDIA GPU, set:
#   OLLAMA_GPU_DEVICE=nvidia.com/gpu=all
# and recreate the container. One-time host setup needed first (driver +
# nvidia-container-toolkit + CDI spec) — see README "GPU acceleration".
OLLAMA_GPU_DEVICE=

# Hosted-provider API keys — only the key for the selected LLM_PROVIDER is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ticket backends the assistant drives — space/comma separated, all used at once. Any of:
#   Http     - the in-repo TicketingMock service (board at http://localhost:5090)
#   Jira     - a real Jira Cloud site, each user logging in via OAuth (see below)
#   InMemory - offline in-process stub
# e.g. "Http Jira" to work the mock and Jira together. Reads merge across all; a new ticket goes
# to whichever backend owns the project you pick.
TICKETS_BACKENDS=Http

# --- Jira Cloud via OAuth (only used when TICKETS_BACKEND=Jira) ---
# Register an OAuth 2.0 (3LO) app at developer.atlassian.com (see the README walkthrough) and
# paste its client id/secret here. Add http://localhost:5080/api/auth/jira/callback as a
# callback URL on the app. For access to ALL of the account's sites (workspaces), set the app's
# Access to Account-level. Users then click "Connect Jira" in the console to log in — no shared
# token, and their own account is used for everything.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Only override these if the API / console aren't on the default localhost ports.
#ATLASSIAN_REDIRECT_URI=http://localhost:5080/api/auth/jira/callback
#ATLASSIAN_FRONTEND_ORIGIN=http://localhost:4200

# Optional default project for new tickets. Leave unset to choose the project per ticket in the
# UI (the assistant reads across all projects/sites regardless).
#TICKETS_JIRA_PROJECT_KEY=
# Issue type used when a create doesn't name a kind — "Task" exists in most projects; "Bug"/"Story"
# also common. Asking for "a task" or "a bug" picks the kind per item, overriding this.
#TICKETS_JIRA_ISSUE_TYPE=Task
# When true, a user sees the issues they reported *or* are assigned — nothing else (genuinely
# per-user: each session acts as its own logged-in Jira account). Set false to include everything
# the account can see. (Renamed from TICKETS_JIRA_SCOPE_TO_REPORTER.)
#TICKETS_JIRA_SCOPE_TO_CURRENT_USER=true
