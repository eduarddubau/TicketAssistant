# Copy to .env (gitignored) and override as needed. docker compose reads .env automatically.

# Which LLM backend the assistant uses:
#   Ollama    - local, no API key (default)
#   Anthropic - Claude models
#   OpenAI    - GPT models
#   Google    - Gemini models (official Google.GenAI SDK)
LLM_PROVIDER=Ollama

# Ollama models, space-separated: the FIRST is the assistant's default; all of them are
# downloaded automatically on startup and offered in the console's model dropdown. Edit
# and re-run the up script to change the lineup. qwen2.5:7b is a heavier alternative
# with stronger multi-step tool calling.
OLLAMA_MODELS=qwen2.5:3b qwen2.5:1.5b

# How long Ollama keeps a model in memory after use. Default -1 (forever) so replies stay
# fast; set e.g. 10m to free the (V)RAM when idle at the cost of a ~1 min reload.
#OLLAMA_KEEP_ALIVE=-1

# Ollama compute: leave empty for CPU (default). To run on the host's NVIDIA GPU, set:
#   OLLAMA_GPU_DEVICE=nvidia.com/gpu=all
# and recreate the container. One-time host setup needed first (driver +
# nvidia-container-toolkit + CDI spec) — see README "GPU acceleration".
OLLAMA_GPU_DEVICE=

# Hosted-provider API keys — only the key for the selected LLM_PROVIDER is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
